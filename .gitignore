# ==========================================
# TaskFlow — Master .gitignore
# Covers Repository Root, Backend, and Frontend
# ==========================================

# Dependencies
node_modules/
.pnpm-store/

# Build & Compilation Outputs
dist/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts.bak

# Environment Configuration (Never commit secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
*.env

# Preserve environment templates
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime & Process IDs
pids/
*.pid
*.seed
*.pid.lock

# Coverage & Testing
coverage/
.nyc_output/

# IDE, Editor & Tooling Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
